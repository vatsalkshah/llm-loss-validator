# Example environment file for validation-only operation
START_MODE=validation
HF_TOKEN=your_hugging_face_token
FLOCK_API_KEY=your_flock_api_key
TASK_ID=8,9
VALIDATION_ARGS_FILE=validation_config_cpu.json.example
AUTO_CLEAN_CACHE=true
LORA_ONLY=true
CACHE_DIR=/cache/huggingface
CACHE_MAX_SIZE_GB=120
CACHE_EVICTION_STRATEGY=LRU
CACHE_AUTO_EVICT=true
TELEMETRY_ENABLED=false
