# Example environment file for inference-only operation
START_MODE=inference
HF_TOKEN=your_hugging_face_token
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
SERVER_WORKERS=2
REQUIRE_API_KEY=true
API_KEY=change_me
API_KEY_HEADER=X-API-Key
REJECT_NON_CACHED_MODELS=true
CACHE_DIR=/models/cache
CACHE_MAX_SIZE_GB=200
CACHE_EVICTION_STRATEGY=LRU
CACHE_AUTO_EVICT=true
TLS_ENABLED=true
TLS_CERT_PATH=/etc/ssl/certs/api.crt
TLS_KEY_PATH=/etc/ssl/private/api.key
MAX_GEN_TOKENS_LIMIT=1024
DEFAULT_MAX_TOKENS=512
DEFAULT_TEMPERATURE=0.7
TELEMETRY_ENABLED=false
