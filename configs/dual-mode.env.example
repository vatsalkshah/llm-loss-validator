# Example environment file for dual-mode (validation + inference) workers
START_MODE=dual
HF_TOKEN=your_hugging_face_token
FLOCK_API_KEY=your_flock_api_key
TASK_ID=12,27
VALIDATION_ARGS_FILE=validation_config.json.example
INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8000
POLLING_INTERVAL=180
TELEMETRY_INTERVAL_SECONDS=60
TELEMETRY_WEBHOOK_URL=https://telemetry.example.com/heartbeat
TELEMETRY_LOCATION=iad-gpu-01
TELEMETRY_WORKER_ID=worker-01
CACHE_DIR=/models/cache
CACHE_MAX_SIZE_GB=200
CACHE_EVICTION_STRATEGY=LRU
CACHE_AUTO_EVICT=true
REJECT_NON_CACHED_MODELS=true
REQUIRE_API_KEY=true
API_KEY=change_me
API_KEY_HEADER=X-API-Key
TLS_ENABLED=true
TLS_CERT_PATH=/etc/ssl/certs/worker.crt
TLS_KEY_PATH=/etc/ssl/private/worker.key
