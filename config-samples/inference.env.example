# ============================================================================
# Inference-only worker configuration
# Copy this file to .env and update the placeholder values before running
# ============================================================================

# Required credentials
HF_TOKEN=your_huggingface_token

# Inference API settings
WORKER_MODE=inference
INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8000
# Full uvicorn module path such as "server:app" or "api.main:application"
INFERENCE_MODULE=server:app

# Cache management
CACHE_DIR=/data/huggingface-cache
CACHE_LIMIT_GB=50

# Model preload configuration (optional - depends on implementation)
# PRELOAD_MODEL=meta-llama/Llama-2-7b-chat-hf
# PRELOAD_TOKENIZER=meta-llama/Llama-2-7b-chat-hf

# API features (optional - depends on implementation)
MAX_CONCURRENT_REQUESTS=10
REQUEST_TIMEOUT=300
ENABLE_STREAMING=true

# Telemetry and heartbeat
TELEMETRY_ENABLED=false
TELEMETRY_URL=https://telemetry.example.com/ingest
HEARTBEAT_INTERVAL=60

# TLS termination (optional - only if serving HTTPS directly from the worker)
TLS_ENABLED=false
# TLS_CERT_PATH=/etc/ssl/certs/inference.crt
# TLS_KEY_PATH=/etc/ssl/private/inference.key

# Additional overrides (uncomment as needed)
# LOG_LEVEL=INFO
# DEBUG_MODE=false
