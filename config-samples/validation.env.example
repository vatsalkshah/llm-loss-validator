# ============================================================================
# Validation-only worker configuration (legacy workflow)
# Copy this file to .env and update the placeholder values before running
# ============================================================================

# Required credentials
HF_TOKEN=your_huggingface_token
FLOCK_API_KEY=your_flock_api_key

# Validation loop settings
WORKER_MODE=validation
# Comma-separated task identifiers that the validator should service
TASK_ID=8,9
# Path is resolved relative to src/start.sh
VALIDATION_ARGS_FILE=validation_config.json.example
AUTO_CLEAN_CACHE=true
LORA_ONLY=true

# Cache management (optional)
CACHE_DIR=/data/huggingface-cache
CACHE_LIMIT_GB=40

# Telemetry and heartbeat (optional)
TELEMETRY_URL=
HEARTBEAT_ENDPOINT=https://fed-ledger-prod.flock.io/api/v1/worker-heartbeat
HEARTBEAT_INTERVAL=60

# Additional overrides (uncomment as needed)
# INFERENCE_HOST=0.0.0.0
# INFERENCE_PORT=8000
# TELEMETRY_TLS_CERT_PATH=/etc/ssl/certs/worker.crt
# TELEMETRY_TLS_KEY_PATH=/etc/ssl/private/worker.key
# TELEMETRY_TLS_CA_PATH=/etc/ssl/certs/root_ca.pem
