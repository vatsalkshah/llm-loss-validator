# ============================================================================
# Dual-mode (validation + inference) configuration
# Copy this file to .env and update the placeholder values before running
# ============================================================================

# Required credentials
HF_TOKEN=your_huggingface_token
FLOCK_API_KEY=your_flock_api_key

# Worker mode configuration
WORKER_MODE=dual

# Validation loop settings
# Comma-separated task IDs that this worker will validate
TASK_ID=8,9
VALIDATION_ARGS_FILE=validation_config.json.example
AUTO_CLEAN_CACHE=true
LORA_ONLY=true

# Inference API settings
# Set INFERENCE_MODULE to the uvicorn module path (e.g., "server:app")
# OR set INFERENCE_COMMAND to a full shell command (e.g., "python server.py --port 8000")
INFERENCE_MODULE=server:app
INFERENCE_HOST=0.0.0.0
INFERENCE_PORT=8000

# API behavior (implementation-dependent)
MAX_CONCURRENT_REQUESTS=8
REQUEST_TIMEOUT=300
ENABLE_STREAMING=true

# Cache management
CACHE_DIR=/data/huggingface-cache
CACHE_LIMIT_GB=50

# Telemetry and heartbeat
TELEMETRY_ENABLED=true
TELEMETRY_URL=https://telemetry.example.com/ingest
HEARTBEAT_ENDPOINT=https://fed-ledger-prod.flock.io/api/v1/worker-heartbeat
HEARTBEAT_INTERVAL=60

# TLS configuration (optional - only if you terminate TLS at the worker)
TLS_ENABLED=false
# TLS_CERT_PATH=/etc/ssl/certs/worker.crt
# TLS_KEY_PATH=/etc/ssl/private/worker.key
# TLS_CA_PATH=/etc/ssl/certs/root_ca.pem

# Additional settings
LOG_LEVEL=INFO
# CUDA_VISIBLE_DEVICES=0,1
