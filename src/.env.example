# ============================================================================
# FLock LLM Validator Configuration
# ============================================================================
# Copy this file to .env and configure for your deployment

# ============================================================================
# Required Credentials
# ============================================================================

# Hugging Face API Token (required for model downloads)
# Get your token from: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# FLock API Key (required for validation mode)
# Get your key from the FLock platform
FLOCK_API_KEY=your_flock_api_key_here

# ============================================================================
# Worker Mode Configuration
# ============================================================================

# Worker operation mode: validation | inference | dual
# - validation: Only run validation loop (default, original behavior)
# - inference: Only run inference API server
# - dual: Run both validation and inference simultaneously
WORKER_MODE=validation

# ============================================================================
# Validation Settings
# ============================================================================

# Time to sleep between validation loops (in seconds)
# Default: 600 (10 minutes)
TIME_SLEEP=600

# Assignment lookup interval (in seconds)
# How often to check for new validation assignments
# Default: 180 (3 minutes)
ASSIGNMENT_LOOKUP_INTERVAL=180

# ============================================================================
# Inference API Settings
# ============================================================================

# Port for the inference API server
INFERENCE_PORT=8000

# Host to bind the inference server to
INFERENCE_HOST=0.0.0.0

# Maximum concurrent requests for inference
MAX_CONCURRENT_REQUESTS=10

# Request timeout (in seconds)
REQUEST_TIMEOUT=300

# Enable streaming responses
ENABLE_STREAMING=true

# ============================================================================
# Cache Management
# ============================================================================

# Maximum cache size in gigabytes
# The system will attempt to keep cache under this limit
MAX_CACHE_SIZE_GB=50

# Auto-clean cache except for base models
AUTO_CLEAN_CACHE=true

# Cache directory path (defaults to HuggingFace cache)
# CACHE_DIR=/path/to/custom/cache

# ============================================================================
# Telemetry & Monitoring
# ============================================================================

# Enable telemetry reporting
TELEMETRY_ENABLED=false

# Telemetry endpoint URL (if telemetry is enabled)
# TELEMETRY_URL=https://your-telemetry-endpoint.com/api/metrics

# Heartbeat reporting interval (in seconds)
# HEARTBEAT_INTERVAL=60

# ============================================================================
# TLS/SSL Configuration
# ============================================================================

# Enable TLS for inference API
TLS_ENABLED=false

# Path to TLS certificate file (PEM format)
# TLS_CERT_PATH=/path/to/cert.pem

# Path to TLS private key file (PEM format)
# TLS_KEY_PATH=/path/to/key.pem

# ============================================================================
# Container Environment
# ============================================================================

# Flag to indicate running in Docker container
# Automatically set to 1 in Dockerfiles
# IS_DOCKER_CONTAINER=1

# ============================================================================
# Advanced Settings
# ============================================================================

# CUDA visible devices (set which GPUs to use)
# Example: CUDA_VISIBLE_DEVICES=0,1
# CUDA_VISIBLE_DEVICES=0

# PyTorch distributed settings
# MASTER_ADDR=localhost
# MASTER_PORT=29500

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Enable detailed logging for debugging
# DEBUG_MODE=false
